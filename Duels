    {pos=Vector3.new(-474.7,-5.9,91.0)}, {pos=Vector3.new(-476.1,-5.5,25.4)}
}
local function spMove(hrp, cur, nxt, speed)
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not spActive then conn:Disconnect() hrp.AssemblyLinearVelocity = Vector3.zero return end
        local pos = hrp.Position
        local target = Vector3.new(cur.X, pos.Y, cur.Z)
        local dir = target - pos
        local dist = dir.Magnitude
        local stopD = math.clamp(1.35 - dist*0.04, 0.65, 1.35)
        if dist <= stopD then conn:Disconnect() hrp.AssemblyLinearVelocity = Vector3.zero return end
        local md = dir.Unit
        if nxt then md = (md + (Vector3.new(nxt.X, pos.Y, nxt.Z) - pos).Unit * 0.45).Unit end
        if spLastVel.Magnitude > 0.1 then md = (md*0.88 + spLastVel.Unit*0.12).Unit end
        local vel = Vector3.new(md.X*speed, hrp.AssemblyLinearVelocity.Y, md.Z*speed)
        hrp.AssemblyLinearVelocity = vel
        spLastVel = Vector3.new(vel.X, 0, vel.Z)
    end)
    while spActive and (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(cur.X, 0, cur.Z)).Magnitude > 1.35 do
        RunService.Heartbeat:Wait()
    end
end
local function spRun(path)
    local hrp = (Player.Character or Player.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart")
    for i, p in ipairs(path) do
        if not spActive then return end
        local speed = i > 2 and 29.6 or 59.2
        spMove(hrp, p.pos, path[i+1] and path[i+1].pos, speed)
        if i == 2 then task.wait(0.2) else task.wait(0.01) end
    end
end
local function startStealPath(path)
    spActive = true
    task.spawn(function() while spActive do spRun(path) task.wait(0.1) end end)
end
local function stopStealPath()
    spActive = false
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
end

