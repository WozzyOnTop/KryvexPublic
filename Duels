local function CreateToggle(parent, labelText, key, callback, order)
    local row = Create("Frame", {
        BackgroundColor3=Color3.fromRGB(22,3,2), Size=UDim2.new(1,-3,0,26),
        LayoutOrder=order or 0, ZIndex=6, Parent=parent
    }, {
