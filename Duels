        Font=Enum.Font.GothamBold, Text=labelText, TextColor3=TXT,
        TextSize=9, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=7, Parent=row
    })
    local isOn = Enabled[key] or false
    local tBg = Create("Frame", {
        Size=UDim2.new(0,28,0,14), Position=UDim2.new(1,-34,0.5,-7),
        BackgroundColor3=isOn and RED or Color3.fromRGB(55,5,5), ZIndex=7, Parent=row
    }, {Create("UICorner", {CornerRadius=UDim.new(1,0)})})
    local tDot = Create("Frame", {
        Size=UDim2.new(0,10,0,10),
        Position=isOn and UDim2.new(1,-13,0.5,-5) or UDim2.new(0,2,0.5,-5),
        BackgroundColor3=Color3.new(1,1,1), ZIndex=8, Parent=tBg
    }, {Create("UICorner", {CornerRadius=UDim.new(1,0)})})
    local btn = Create("TextButton", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=9, Parent=row})

    local function setVisual(state, skipCb)
        isOn = state
        TweenService:Create(tBg, TweenInfo.new(0.2), {BackgroundColor3=isOn and RED or Color3.fromRGB(50,5,5)}):Play()
        TweenService:Create(tDot, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
            Position=isOn and UDim2.new(1,-13,0.5,-5) or UDim2.new(0,2,0.5,-5)
        }):Play()
        if not skipCb then callback(isOn) end
    end
    VisualSetters[key] = setVisual
    btn.MouseButton1Click:Connect(function()
        isOn = not isOn Enabled[key] = isOn setVisual(isOn)
    end)
    return row
end

local function CreateSlider(parent, labelText, minV, maxV, key, callback, order)
    local cont = Create("Frame", {
        BackgroundColor3=Color3.fromRGB(22,3,2), Size=UDim2.new(1,-3,0,36),
        LayoutOrder=order or 0, ZIndex=6, Parent=parent
    }, {
        Create("UICorner", {CornerRadius=UDim.new(0,7)}),
        Create("UIStroke", {Color=RED_D, Thickness=1.5})
    })
    local lbl = Create("TextLabel", {
        BackgroundTransparency=1, Size=UDim2.new(0.85,0,0,14), Position=UDim2.new(0,7,0,3),
        Font=Enum.Font.GothamBold, Text=labelText..": "..tostring(Values[key]),
        TextColor3=Color3.fromRGB(255,160,160), TextSize=8,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=7, Parent=cont
    })
    local sBg = Create("Frame", {
        BackgroundColor3=Color3.fromRGB(22,3,2), Position=UDim2.new(0,7,0,22),
        Size=UDim2.new(1,-14,0,8), ZIndex=7, Parent=cont
    }, {Create("UICorner", {CornerRadius=UDim.new(1,0)})})
    local pct = math.clamp((Values[key]-minV)/(maxV-minV),0,1)
    local fill = Create("Frame", {BackgroundColor3=RED, Size=UDim2.new(pct,0,1,0), ZIndex=8, Parent=sBg},
        {Create("UICorner", {CornerRadius=UDim.new(1,0)})})
    local knob = Create("Frame", {
        BackgroundColor3=Color3.new(1,1,1), Size=UDim2.new(0,10,0,10),
        Position=UDim2.new(pct,-5,0.5,-5), ZIndex=9, Parent=sBg
    }, {
        Create("UICorner", {CornerRadius=UDim.new(1,0)}),
        Create("UIStroke", {Color=RED, Thickness=2})
    })
    local sBtn = Create("TextButton", {
        Size=UDim2.new(1,0,3,0), Position=UDim2.new(0,0,-1,0),
        BackgroundTransparency=1, Text="", ZIndex=10, Parent=sBg
    })
    local drag = false
    sBtn.MouseButton1Down:Connect(function() drag = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local rel = math.clamp((i.Position.X - sBg.AbsolutePosition.X)/sBg.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(rel,0,1,0)
            knob.Position = UDim2.new(rel,-5,0.5,-5)
            local val = math.floor(minV + (maxV-minV)*rel)
            Values[key] = val
            lbl.Text = labelText..": "..tostring(val)
            callback(val)
        end
    end)
    return cont
end

