-- Anti Ragdoll
local AR = {mode=nil, conns={}, char={}, boosting=false}
local function arCache()
    local char = Player.Character; if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end
    AR.char = {c=char, h=hum, r=root}; return true
end
local function arIsRagdolled()
    if not AR.char.h then return false end
    local s = AR.char.h:GetState()
    if s == Enum.HumanoidStateType.Physics or s == Enum.HumanoidStateType.Ragdoll or s == Enum.HumanoidStateType.FallingDown then return true end
    local e = Player:GetAttribute("RagdollEndTime")
    return e and (e - workspace:GetServerTimeNow()) > 0
end
local function arForceExit()
    if not AR.char.h or not AR.char.r then return end
    pcall(function() Player:SetAttribute("RagdollEndTime", workspace:GetServerTimeNow()) end)
    for _, d in ipairs(AR.char.c:GetDescendants()) do
        if d:IsA("BallSocketConstraint") or (d:IsA("Attachment") and d.Name:find("RagdollAttachment")) then d:Destroy() end
    end
    if not AR.boosting then AR.boosting = true AR.char.h.WalkSpeed = 400 end
    if AR.char.h.Health > 0 then AR.char.h:ChangeState(Enum.HumanoidStateType.Running) end
    AR.char.r.Anchored = false
end
local function startAntiRagdoll()
    if AR.mode == "v1" then return end
    if not arCache() then return end
    AR.mode = "v1"
    table.insert(AR.conns, RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if cam and AR.char.h then cam.CameraSubject = AR.char.h end
    end))
    table.insert(AR.conns, Player.CharacterAdded:Connect(function()
        AR.boosting = false task.wait(0.5) arCache()
    end))
    task.spawn(function()
        while AR.mode == "v1" do
            task.wait()
            if not Enabled.AntiRagdoll then break end
            local r = arIsRagdolled()
            if r then arForceExit()
            elseif AR.boosting and not r then AR.boosting = false if AR.char.h then AR.char.h.WalkSpeed = 16 end end
        end
    end)
end
local function stopAntiRagdoll()
    AR.mode = nil
    if AR.boosting and AR.char.h then AR.char.h.WalkSpeed = 16 end
    AR.boosting = false
    for _, c in ipairs(AR.conns) do pcall(function() c:Disconnect() end) end
    AR.conns = {} AR.char = {}
end

